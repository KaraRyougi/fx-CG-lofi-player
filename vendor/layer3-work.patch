 # include "huffman.h"
 # include "layer3.h"
 
+/* CGplayer100: the requantization work array (4.6 KB, rewritten for every
+   granule) is a static buffer instead of III_decode()'s stack array, so
+   that the build can place it in on-chip memory (MAD_WORK_XYRAM: gint's
+   .xyram section at 0xe500e000) and keep its bursts of stores off the
+   external bus. The decoder runs single-threaded here; III_decode() is no
+   longer reentrant. mad_layer_III_xr may be repointed between frames (the
+   diagnostic build switches it against an SDRAM buffer). */
+# if defined(MAD_WORK_XYRAM)
+#  define MAD_WORK_ATTR __attribute__((section(".xyram")))
+# else
+#  define MAD_WORK_ATTR
+# endif
+static mad_fixed_t III_xr_work[2][576] MAD_WORK_ATTR;
+mad_fixed_t (*mad_layer_III_xr)[576] = III_xr_work;
+
 /* --- Layer III ----------------------------------------------------------- */
 
